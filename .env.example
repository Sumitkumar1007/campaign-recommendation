# Copy this file to .env on the server and fill real values there.
# Never commit .env because it can contain passwords.

# Postgres source and snapshot storage
PGHOST=your_postgres_host
PGPORT=5432
PGDATABASE=postgres
PGUSER=postgres
PGPASSWORD=replace_with_secret

# Source communication table
SOURCE_SCHEMA=digital_collections
SOURCE_TABLE=communications
COMMUNICATION_VERTICAL_COLUMN=vertical

# Source digital cases table
CASES_TABLE=digital_cases
CASES_VERTICAL_COLUMN=vertical

# Target schema/tables used by the pipeline
TARGET_SCHEMA=digital_collections
CAMPAIGN_TABLE=ai_ml_campaign_recommendations
CAMPAIGN_MAPPING_TABLE=ai_ml_campaign_mapping

# Monthly inference defaults
MODEL_NAME=catboost_3m
FEATURE_MONTH_SOURCE=emi_date
MODEL_SERVING=local
# CAMPAIGN_VERTICAL=LAP
# Fallback only. Primary scheduler vendor now comes from:
# select value from data_config where key_name = 'voice.service.vendor-list'
# CAMPAIGN_VENDOR=prutech-cpass

# Strategy weighting for CatBoost training/inference feature generation
STRATEGY_USE_STATUS_WEIGHTS=false
STRATEGY_SAMPLE_WEIGHT_POSITIVE_BOOST=1.0
# Optional JSON override. Example:
# STRATEGY_SUCCESS_SCORES_JSON={"SMS":{"SENT":0.5,"DELIVERED":1.0,"CLICKED":2.0},"WH":{"SENT":0.5,"DELIVERED":1.0,"READ":1.5,"CLICKED":2.0},"VOICE":{"CONNECTED":1.0,"CALL_CONNECTED":1.0},"VOICE_BOT":{"CONNECTED":1.0,"CALL_CONNECTED":1.0}}
STRATEGY_SUCCESS_SCORES_JSON=

# MLflow registry
MLFLOW_TRACKING_URI=http://your_mlflow_host:5000
MLFLOW_REGISTERED_MODEL_NAME=campaign_next_month_catboost_3m
MLFLOW_MODEL_URI=models:/campaign_next_month_catboost_3m@production


# API service
API_HOST=0.0.0.0
API_PORT=8040
API_AUTH_USERNAME=aiml
API_AUTH_PASSWORD=replace_with_api_password
API_AUTH_SECRET=replace_with_long_random_secret
API_TOKEN_TTL_SECONDS=3600
AI_CONFIG_TABLE=ai_configurations
API_AUDIT_TABLE=api_audit_log
API_MODEL_BASE_VERSION=v1.1.0
API_EXPORT_AFTER_INFERENCE=true
API_EXPORT_WRITE=true
# SFTP upload after workbook generation
SFTP_EXPORT_PATH=/path/to/local/sftp/drop
SFTP_UPLOAD_ENABLED=false
SFTP_HOST=your_sftp_host
SFTP_PORT=22
SFTP_USERNAME=your_sftp_username
SFTP_PASSWORD=replace_with_sftp_password
SFTP_PRIVATE_KEY_PATH=/path/to/private/key
SFTP_PRIVATE_KEY_PASSPHRASE=
SFTP_REMOTE_PATH=/upload/path
SFTP_REMOTE_DATASET_PATH=/upload/dataset/path
SFTP_REMOTE_SCHEDULER_PATH=/upload/scheduler/path
SFTP_RETRIES=3
SFTP_RETRY_DELAY_SECONDS=5
SFTP_TIMEOUT_SECONDS=30
SFTP_FAIL_ON_ERROR=false
