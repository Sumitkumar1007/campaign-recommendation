[Unit]
Description=Recommendation Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/aiml/recommendation
Environment=PYTHONUNBUFFERED=1
Environment=API_HOST=0.0.0.0
Environment=API_PORT=8081
EnvironmentFile=-/home/ubuntu/aiml/recommendation/.env
ExecStart=/home/ubuntu/aiml/recommendation/venv/bin/python /home/ubuntu/aiml/recommendation/scripts/run_api_service.py
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
