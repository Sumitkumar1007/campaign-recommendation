[Unit]
Description=Recommendation Service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/aiml/recommendation
Environment=PYTHONUNBUFFERED=1
Environment=API_HOST=0.0.0.0
Environment=API_PORT=8040
Environment=GUNICORN_WORKERS=1
Environment=GUNICORN_THREADS=8
Environment=GUNICORN_TIMEOUT=300
EnvironmentFile=-/home/ubuntu/aiml/recommendation/.env
ExecStart=/home/ubuntu/aiml/recommendation/venv/bin/gunicorn --workers ${GUNICORN_WORKERS} --threads ${GUNICORN_THREADS} --worker-class gthread --bind ${API_HOST}:${API_PORT} --timeout ${GUNICORN_TIMEOUT} --access-logfile - --error-logfile - campaign_recommendation.wsgi:app
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
